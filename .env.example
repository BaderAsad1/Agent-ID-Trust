# Agent ID production environment template
# Copy to your deployment secret manager. Never commit populated secrets.

# Runtime
NODE_ENV=production
PORT=8080
LOG_LEVEL=info
APP_URL=https://getagent.id
APP_BASE_URL=https://getagent.id
AUTH_BASE_URL=https://getagent.id
API_BASE_URL=https://getagent.id/api/v1
BASE_AGENT_DOMAIN=getagent.id
MAIL_BASE_DOMAIN=getagent.id
COOKIE_DOMAIN=.getagent.id
TRUST_PROXY=1
ALLOWED_ORIGINS=https://getagent.id
MCP_PORT=3001
SANDBOX_MODE=disabled
MARKETPLACE_COMMERCE_ENABLED=false

# PostgreSQL and Redis
DATABASE_URL=postgresql://user:password@host:5432/agentid?sslmode=require
DB_POOL_MAX=20
REDIS_URL=rediss://user:password@host:6379

# Required production secrets
# Generate independent values, each at least 32 random bytes.
ACTIVITY_HMAC_SECRET=
WEBHOOK_SECRET_KEY=
CREDENTIAL_SIGNING_SECRET=
JWT_SECRET=
CLAIM_TOKEN_SECRET=
ADMIN_SECRET_KEY=
ADMIN_ALLOWED_IPS=
OAUTH_INTROSPECTION_SECRET=

# W3C Verifiable Credentials (Ed25519 JWK JSON)
VC_SIGNING_KEY=
VC_PUBLIC_KEY=
VC_KEY_ID=agentid-vc-key-1

# OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stripe subscriptions and marketplace payments
# Use the live key in production; there is intentionally no alternate live-key alias.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_YEARLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_HANDLE_STANDARD=
STRIPE_PRICE_HANDLE_PREMIUM=
STRIPE_PRICE_HANDLE_ELITE=

# Transactional email
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
FROM_EMAIL=notifications@getagent.id
TEAM_EMAIL=team@getagent.id

# Cloudflare DNS
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# Cloudflare R2 attachment storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Base / x402. Leave disabled until production addresses are verified.
X402_ENABLED=false
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
CDP_WALLET_SECRET=
CDP_NETWORK_ID=base-mainnet
PLATFORM_TREASURY_ADDRESS=
BASE_RPC_URL=
BASE_CHAIN_ID=8453
BASE_PLATFORM_WALLET=
BASE_AGENTID_REGISTRAR=
BASE_ERC8004_REGISTRY=
BASE_HANDLE_CONTRACT=
BASE_MINTER_PRIVATE_KEY=
BASE_METADATA_URI=
IS_TESTNET=false

# On-chain minting and transfer detection are launch-disabled by default.
ONCHAIN_MINTING_ENABLED=false
MULTI_CHAIN_ENABLED=false
NFT_TRANSFER_DETECTOR_ENABLED=false
HANDLE_CLAIM_SIGNING_PRIVATE_KEY=
HANDLE_CLAIM_ISSUER=agentid-api
HANDLE_CLAIM_MAX_AGE_SECONDS=300

# Optional Tron integration
TRON_API_URL=
TRON_MINTER_PRIVATE_KEY=
TRON_CONTRACT_ADDRESS=
TRON_HANDLE_MINTED_TOPIC=

# Local encrypted wallet storage (use a persistent encrypted volume)
OWS_VAULT_PATH=.ows-vault

# Frontend build variables
VITE_API_BASE_URL=https://getagent.id/api/v1
VITE_WAITLIST_ENABLED=false
